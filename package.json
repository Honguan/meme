{
  "name": "meme-clash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-server.mjs",
    "dev:online": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply meme-matches --local",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/game.test.js tests/matches.test.js tests/storage.test.js",
    "test:browser": "playwright test",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "catalog:collect": "node scripts/collect-world.mjs",
    "catalog:build": "node scripts/build-world.mjs"
  },
  "overrides": {
    "@esbuild-kit/core-utils": { "esbuild": "^0.25.12" }
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "vite": "^7.3.1",
    "wrangler": "^4.147.0"
  }
}
